# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,https://percel-client-next.vercel.app
APP_URL=http://localhost:5000

# Database (PostgreSQL)
# Either set DATABASE_URL, or the discrete DB_* values below.
# DATABASE_URL=postgresql://user:password@host:5432/percel_nest
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=percel_nest
# Set to false for a local Postgres without TLS. Managed hosts need it on.
DB_SSL=false
# Run pending migrations on boot. Prefer `npm run migration:run` in CI/deploy.
DB_MIGRATIONS_RUN=false

# Auth / JWT
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_long_random_secret
JWT_REFRESH_EXPIRES=7d
BCRYPT_SALT_ROUND=10

# Initial super admin seed (optional)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me

# RAG providers
PINECONE_API_KEY=replace_with_pinecone_api_key
PINECONE_INDEX=replace_with_pinecone_index
HUGGINGFACE_API_KEY=replace_with_huggingface_api_key
GROQ_API_KEY=replace_with_groq_api_key

# Groq retires models with little notice; override without a code change.
GROQ_MODEL=openai/gpt-oss-20b

# Supabase keep-alive cron (Vercel Cron hits /api/keep-alive daily)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
CRON_SECRET=replace_with_long_random_secret

# Where emailed links point (the frontend, not this API).
# Falls back to the first CORS_ORIGIN entry.
FRONTEND_URL=http://localhost:3001

# Outbound email. Without SMTP_HOST, mail is logged instead of sent.
# Gmail app passwords may be pasted with the spaces Google shows.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Parcel Delivery <no-reply@example.com>"

# Delivery pricing. All optional — defaults are in pricing.util.ts.
PRICING_BASE_FEE=60
PRICING_PER_KG_FEE=25
PRICING_INCLUDED_KG=1
PRICING_COD_FEE_PERCENT=1
PRICING_MINIMUM_FEE=60

# Connection pool size. Supabase's session pooler (port 5432) allows 15
# clients in total, and node-postgres defaults to 10 per instance.
DB_POOL_MAX=5

# Set to true to insert dummy data when migrations run. Never in production.
SEED_DUMMY_DATA=false
